# Шаблон конфигурации. Скопировать в .env и заполнить своими значениями:
#   cp .env.example .env

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- Приложение ---
# Ключ подписи сессионных кук. Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=postgresql+asyncpg://iskcon:iskcon@localhost:5436/iskcon_news

# Адрес фронтенда для CORS (Vite dev-сервер)
FRONTEND_ORIGIN=http://localhost:5173
